# Copy to scripts/.env.deploy (that file is gitignored) and set values.
#
# SSH key (recommended):
# DEPLOY_SSH_KEY=/Users/you/.ssh/id_ed25519
#
# Or password rsync (requires `sshpass`):
# DEPLOY_SSH_PASS=your-ssh-password
#
# Optional overrides:
# DEPLOY_USER=root
# DEPLOY_HOST=72.61.148.117
# DEPLOY_PATH=/var/www/resumebuilder.fun
